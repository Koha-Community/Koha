[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% USE KohaDates %]
[% USE Branches %]
[% USE TablesSettings %]
[% USE To %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% t("Transfers to receive") | html %]
        &rsaquo; [% t("Circulation") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="circ_transferstoreceive" class="circ">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'circ-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/circ/circulation-home.pl">Circulation</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Transfers to receive</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% SET aside = Koha.Preference('CircSidebar') ? 'circ-nav' : '' %]
[% WRAPPER 'main-container.inc' aside=aside %]
    <h1>Transfers made to your library as of [% show_date | $KohaDates %]</h1>
    <p>Your library is the destination for the following transfer(s)</p>
    [% IF ( TransfersMaxDaysWarning ) %]<p>Transfers are <span class="error">considered late</span> after [% TransfersMaxDaysWarning | html %] days.</p>[% END %]
    <div id="resultlist">
        <div class="page-section">
            <table id="transferstoreceive" data-branchcode="[% branchcode | html %]"></table>
        </div>
        <!-- /.page-section -->
    </div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'js-biblio-format.inc' %]
    [% INCLUDE 'js-date-format.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]">
        var table_settings = [% TablesSettings.GetTableSettings( 'circ', 'transferstoreceive', 'transferstoreceive', 'json' ) | $raw %];
        var TransfersMaxDaysWarning = [% TransfersMaxDaysWarning ? TransfersMaxDaysWarning : 0 | html %];

        var all_libraries = [% To.json(Branches.all) | $raw %].map(function (e) {
            e["_id"] = e.branchcode;
            e["_str"] = e.branchname;
            return e;
        });

        // Mirror the legacy "late transfer" calculation: a transfer is late once it has been
        // sent for more than TransfersMaxDaysWarning days without arriving
        function days_late(sent_date) {
            if (!sent_date || !TransfersMaxDaysWarning) return 0;
            var sent = new Date(sent_date);
            var threshold = new Date(sent.getFullYear(), sent.getMonth(), sent.getDate() + Number(TransfersMaxDaysWarning));
            var now = new Date();
            var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var diff = Math.floor((today - threshold) / 86400000);
            return diff > 0 ? diff : 0;
        }
    </script>
    <script nonce="[% Koha.CSPNonce | $raw %]">
        $(document).ready(function () {
            var additional_filters = {
                to_library_id: $("#transferstoreceive").data("branchcode"),
                sent_date: { "!=": null },
                arrived_date: { "=": null },
                cancellation_date: { "=": null },
            };

            var transfers_table = $("#transferstoreceive").kohaTable(
                {
                    ajax: {
                        url: "/api/v1/transfers",
                    },
                    language: {
                        emptyTable: _("No transfers to receive"),
                    },
                    embed: ["item+strings", "item.biblio", "item.home_library", "item.item_type", "item.first_hold.patron", "item.recall.patron", "from_library"],
                    order: [[1, "asc"]],
                    orderFixed: { pre: [[0, "asc"]] },
                    rowGroup: {
                        dataSrc: "from_library_id",
                        startRender: function (rows, group) {
                            var first = rows.data()[0];
                            return first.from_library ? escape_str(first.from_library.name) : escape_str(group);
                        },
                    },
                    columns: [
                        {
                            data: "me.from_library_id",
                            title: _("Sent from"),
                            dataFilter: "libraries",
                            searchable: true,
                            orderable: false,
                            render: function (data, type, row, meta) {
                                return row.from_library ? escape_str(row.from_library.name) : "";
                            },
                        },
                        {
                            data: "sent_date",
                            title: _("Date of transfer"),
                            type: "date",
                            searchable: false,
                            orderable: true,
                            render: function (data, type, row, meta) {
                                var html = $date(data);
                                var late = days_late(data);
                                if (late > 0) {
                                    var badge = __nx("{count} day late", "{count} days late", late, { count: late });
                                    html += ` <span class="badge bg-warning text-dark">${badge}</span>`;
                                }
                                return html;
                            },
                        },
                        {
                            data: "item.biblio.title",
                            title: _("Title"),
                            searchable: true,
                            orderable: true,
                            render: function (data, type, row, meta) {
                                var item = row.item;
                                var html = $biblio_to_html(item.biblio, { link: 1 });

                                if (item.biblio.author) {
                                    var author = escape_str(item.biblio.author);
                                    html += ` ${_("by")} ${author}`;
                                }

                                if (item.item_type) {
                                    var item_type = escape_str(item.item_type.translated_description || item.item_type.description);
                                    if (item_type) html += ` (<strong>${item_type}</strong>)`;
                                }

                                if (item._strings.collection_code && item._strings.collection_code.str) {
                                    var collection_code = escape_str(item._strings.collection_code.str);
                                    html += ` <span class="collection_code">${_("Collection:")} ${collection_code}</span>`;
                                }

                                var barcode = escape_str(item.external_id);
                                html += `<br>${_("Barcode:")} ${barcode}`;

                                return html;
                            },
                        },
                        {
                            data: null,
                            title: _("On hold for"),
                            searchable: false,
                            orderable: false,
                            render: function (data, type, row, meta) {
                                var item = row.item;
                                if (item.first_hold) {
                                    return $patron_to_html(item.first_hold.patron, { url: true, display_cardnumber: true });
                                } else if (item.recall) {
                                    var patron = $patron_to_html(item.recall.patron, { url: true, display_cardnumber: true });
                                    return `${_("Recall requested by")} ${patron}`;
                                } else {
                                    return _("None");
                                }
                            },
                        },
                        {
                            data: "item.home_library_id",
                            title: _("Home library"),
                            dataFilter: "libraries",
                            searchable: true,
                            orderable: true,
                            render: function (data, type, row, meta) {
                                return row.item.home_library ? escape_str(row.item.home_library.name) : "";
                            },
                        },
                        {
                            data: "item.callnumber",
                            title: _("Call number"),
                            searchable: true,
                            orderable: true,
                            render: function (data, type, row, meta) {
                                return escape_str(data);
                            },
                        },
                        {
                            data: null,
                            title: _("Actions"),
                            class: "actions",
                            searchable: false,
                            orderable: false,
                            render: function (data, type, row, meta) {
                                var transfer_id = encodeURIComponent(row.transfer_id);
                                return `<a href="#" class="btn btn-default btn-xs cancel-transfer" data-transfer-id="${transfer_id}"><i class="fa fa-times"></i> ${_("Cancel transfer")}</a>`;
                            },
                        },
                    ],
                },
                table_settings,
                1,
                additional_filters,
                { libraries: all_libraries }
            );

            $("#transferstoreceive").on("click", ".cancel-transfer", function (e) {
                e.preventDefault();
                var transfer_id = $(this).data("transfer-id");
                $.ajax({
                    method: "DELETE",
                    url: `/api/v1/transfers/${transfer_id}`,
                    contentType: "application/json",
                    data: JSON.stringify({ cancellation_reason: "Manual" }),
                })
                    .done(function () {
                        transfers_table.DataTable().ajax.reload(null, false);
                    })
                    .fail(function (xhr) {
                        if (xhr.status === 404) {
                            // The transfer was already received or cancelled elsewhere; refresh so the row drops off
                            alert(_("This transfer no longer exists. It may have already been received or cancelled."));
                            transfers_table.DataTable().ajax.reload(null, false);
                        } else {
                            alert(_("Something went wrong, the transfer could not be cancelled"));
                        }
                    });
            });
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
