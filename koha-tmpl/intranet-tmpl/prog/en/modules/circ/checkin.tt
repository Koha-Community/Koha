[% USE raw %]
[% USE To %]
[% USE Asset %]
[% USE Koha %]
[% USE Branches %]
[% USE TablesSettings %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>
    [% FILTER collapse %]
        [% t("Check in") | html %]
        &rsaquo; [% t("Circulation") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]
</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="circ_checkin" class="circ">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'checkin-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/circ/circulation-home.pl">[% t("Circulation") | html %]</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            [% t("Check in") | html %]
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='circ-nav' %]
    <div id="checkin"></div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'calendar.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
        window.__MODULE_POLICY__ = [% To.json(module_policy.to_hashref) | $raw %];
        window.__LIBRARY_ID__ = "[% Branches.GetLoggedInBranchcode | html %]";
        window.__TABLE_SETTINGS__ = [% TablesSettings.GetTableSettings( 'circ', 'returns', 'checkedintable', 'json' ) | $raw %];
        window.__CHECKIN_BARCODE__ = "[% To.json( checkin_barcode ) | $raw %]";
    </script>
    [% Asset.js("js/vue/dist/checkin.js") | $raw %]
[% END %]
[% INCLUDE 'intranet-bottom.inc' %]
