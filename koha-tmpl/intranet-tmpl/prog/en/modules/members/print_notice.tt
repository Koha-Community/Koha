[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% IF notices.size > 1 %]
            [% t("Print notices") | html %]
        [% ELSE %]
            [% t("Print notice") | html %]
        [% END %]
        &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% Asset.css("css/print.css") | $raw %]
<style nonce="[% Koha.CSPNonce | $raw %]">
    iframe.notice-frame {
        display: block;
        width: 100%;
        border: 0;
        overflow: hidden;
    }
</style>
</head>

<body id="tools_print_notice" class="tools">
[% IF notices.size %]
    [% FOR notice IN notices %]
        [%# The notice is not trusted: no scripts can run in its frame, it is only allowed to be the same origin so that the frame can be sized to its content %]
        <iframe class="notice-frame type_[% notice.type | html %]" id="notice_[% notice.id | html %]" title="[% t("Notice content") | html %]" sandbox="allow-same-origin" srcdoc="[% notice.html_content | html %]"></iframe>
        [% IF notices.size > 1 && !loop.last %]<div class="pagebreak"></div>[% END %]
    [% END %]
[% ELSE %]
    <div class="alert alert-info">[% t("No notices were found to print.") | html %]</div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% IF notices.size %]
        <script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
            // Show the whole of each notice, before it is printed
            document.querySelectorAll("iframe.notice-frame").forEach(function (frame) {
                function resize() {
                    var doc = frame.contentDocument;
                    if (!doc || !doc.documentElement) return;
                    // The height of the content, which the height of the frame would otherwise be the minimum of
                    frame.style.height = "0";
                    frame.style.height = doc.documentElement.scrollHeight + "px";
                }
                frame.addEventListener("load", resize);
                resize();
            });
        </script>
        [% INCLUDE 'slip-print.inc' #printThenClose %]
    [% END %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
