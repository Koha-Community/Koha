[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% IF notices.size > 1 %]
            [% t("Print notices") | html %]
        [% ELSE %]
            [% t("Print notice") | html %]
        [% END %]
        &rsaquo; [% t("Tools") | html %] &rsaquo; [% t("Koha") | html %]
    [% END %]</title
>
[% INCLUDE 'doc-head-close.inc' %]
[% Asset.css("css/print.css") | $raw %]
[% IF ( stylesheet ) %]
    <link rel="stylesheet" type="text/css" href="[% stylesheet | html %]" />
[% END %]
<!-- prettier-ignore-start -->
[% IF ( Koha.Preference('AllNoticeCSS') ) %]
    <style nonce="[% Koha.CSPNonce | $raw %]">[% Koha.Preference('AllNoticeCSS') | $raw %]</style>
[% END %]
[% FOR style IN styles %]
    <style nonce="[% Koha.CSPNonce | $raw %]">[% style | $raw %]</style>
[% END %]
[% FOR notice IN notices %]
    [% IF notice.style %]<style nonce="[% Koha.CSPNonce | $raw %]">[% notice.style | $raw %]</style>[% END %]
[% END %]
<!-- prettier-ignore-end -->
</head>

<body id="tools_print_notice" class="tools">
[% IF notices.size %]
    [% FOR notice IN notices %]
        <div id="notice_[% notice.id | html %]" class="type_[% notice.type | html %]">
            [% IF notice.is_html %]
                [% IF ( notice.content ) %][% notice.content | $raw %][% ELSE %][% t("No notice template found") | html %][% END %]
            [% ELSE %]
                <pre>[% IF ( notice.content ) %][% notice.content | html %][% ELSE %][% t("No notice template found") | html %][% END %]</pre>
            [% END %]
        </div>
        [% IF notices.size > 1 && !loop.last %]<div class="pagebreak"></div>[% END %]
    [% END %]
[% ELSE %]
    <div class="alert alert-info">[% t("No notices were found to print.") | html %]</div>
[% END %]

[% MACRO jsinclude BLOCK %]
    [% IF notices.size %]
        [% INCLUDE 'slip-print.inc' #printThenClose %]
    [% END %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
