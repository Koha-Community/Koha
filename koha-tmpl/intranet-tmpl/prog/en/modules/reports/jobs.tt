[% USE raw %]
[% USE Koha %]
[% USE Asset %]
[% USE KohaDates %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %][% t("Report jobs") | html %] &rsaquo; [% t("Reports") | html %] &rsaquo; [% t("Koha") | html %][% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="reports_jobs" class="reports">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/reports/reports-home.pl">Reports</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            <span>Report jobs</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

[% WRAPPER 'main-container.inc' aside='reports-menu' %]
    <style nonce="[% Koha.CSPNonce | $raw %]">
        #table_report_jobs tr.job-status-new {
            background-color: #e0f0ff;
        }
        #table_report_jobs tr.job-status-started,
        #table_report_jobs tr.job-status-running {
            background-color: #fff5cc;
        }
        #table_report_jobs tr.job-status-finished {
            background-color: #e2f5e2;
        }
        #table_report_jobs tr.job-status-cancelled {
            background-color: #ececec;
        }
        #table_report_jobs tr.job-status-failed {
            background-color: #f8d7da;
        }
        #table_report_jobs tr.highlight {
            outline: 2px solid #ff9900;
        }
    </style>

    <h1>Report jobs</h1>

    [% IF new_job_id %]
        <div class="alert alert-info"> Your report has been queued as job #[% new_job_id | html %]. It is highlighted below. </div>
    [% END %]

    <form method="get" class="refresh-form" onsubmit="return false">
        <p>
            <button type="button" id="refresh_now" class="btn btn-default"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</button>

            <label>
                <input type="checkbox" id="auto_refresh" name="auto_refresh" />
                Refresh automatically every <input type="text" inputmode="numeric" pattern="[0-9]*" id="refresh_delay" name="refresh_delay" value="60" size="3" /> seconds.
            </label>

            <span id="refresh_info"></span>
        </p>
    </form>

    <div class="page-section" id="running_section">
        <h2>Currently running</h2>
        <p id="running_empty" style="display:none" class="text-muted">No reports are running right now.</p>
        <table id="table_running_reports" style="display:none">
            <thead>
                <tr>
                    <th>Report</th>
                    <th>Type</th>
                    <th>Owner</th>
                    <th>Running for</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="page-section">
        <h2>Background jobs</h2>
        <fieldset class="rows">
            <ol>
                <li>
                    <label for="time_range">Time range:</label>
                    <select id="time_range">
                        <option value="today" selected="selected">Today</option>
                        <option value="1h">Last 1 hour</option>
                        <option value="8h">Last 8 hours</option>
                        <option value="24h">Last 24 hours</option>
                        <option value="custom">Choose range</option>
                    </select>
                </li>
                <li class="custom_range" style="display:none">
                    <label for="custom_after">From:</label>
                    <input type="text" id="custom_after" data-date_to="custom_before" class="flatpickr" data-flatpickr-enable-time="true" />
                </li>
                <li class="custom_range" style="display:none">
                    <label for="custom_before">To:</label>
                    <input type="text" id="custom_before" class="flatpickr" data-flatpickr-enable-time="true" />
                </li>
                <li class="custom_range" style="display:none">
                    <label>&nbsp;</label>
                    <button type="button" id="apply_custom" class="btn btn-default btn-sm">Apply</button>
                </li>
            </ol>
        </fieldset>

        <table id="table_report_jobs">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Report</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Queued</th>
                    <th>Started</th>
                    <th>Ended</th>
                    <th class="no-export">Actions</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="modal" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title" id="errorModalLabel">Report job error</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="errorModalCode" class="text-muted"></p>
                    <pre id="errorModalMessage" style="white-space:pre-wrap;"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
[% END #/ WRAPPER main-container.inc %]

[% MACRO jsinclude BLOCK %]
    [% Asset.js("js/admin-menu.js") | $raw %]
    [% INCLUDE 'js-date-format.inc' %]
    [% INCLUDE 'datatables.inc' %]
    [% INCLUDE 'calendar.inc' %]
    <script nonce="[% Koha.CSPNonce | $raw %]" data-tt-allowed="true">
        const loggedinusernumber = [% logged_in_user.borrowernumber | html %];
        const can_see_all = [% CAN_user_superlibrarian ? 1 : 0 | html %];
        const new_job_id  = [% new_job_id ? new_job_id : 'null' | html %];
    </script>
    <script nonce="[% Koha.CSPNonce | $raw %]">
        const job_status_labels = {
            new: _("Queued"),
            started: _("Running"),
            running: _("Running"),
            finished: _("Finished"),
            cancelled: _("Cancelled"),
            failed: _("Failed"),
        };

        const error_code_labels = {
            report_not_found: _("The saved report this job referenced no longer exists"),
            execute_error: _("The report's SQL could not be executed"),
            internal_error: _("The worker encountered an unexpected error"),
        };

        function rfc3339(d) {
            const pad = n => String(n).padStart(2, "0");
            const off = -d.getTimezoneOffset();
            const sign = off >= 0 ? "+" : "-";
            const abs = Math.abs(off);
            return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds()) + sign + pad(Math.floor(abs / 60)) + ":" + pad(abs % 60);
        }

        function flatpickr_to_rfc3339(s) {
            if (!s) return "";
            const m = s.match(/^(\d{4})-(\d{2})-(\d{2})\s+(\d{2}):(\d{2})$/);
            if (!m) return s;
            return rfc3339(new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], 0));
        }

        function range_params() {
            const range = $("#time_range").val();
            const now = new Date();
            let after;
            if (range === "today") {
                after = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
            } else if (range === "1h") {
                after = new Date(now.getTime() - 1 * 3600 * 1000);
            } else if (range === "8h") {
                after = new Date(now.getTime() - 8 * 3600 * 1000);
            } else if (range === "24h") {
                after = new Date(now.getTime() - 24 * 3600 * 1000);
            } else if (range === "custom") {
                const a = flatpickr_to_rfc3339($("#custom_after").val());
                const b = flatpickr_to_rfc3339($("#custom_before").val());
                const params = {};
                if (a) params.after = a;
                if (b) params.before = b;
                return params;
            }
            return { after: rfc3339(after) };
        }

        function api_url() {
            const base = "/api/v1/reports/jobs";
            const params = range_params();
            const qs = $.param(params);
            return qs ? base + "?" + qs : base;
        }

        $(document).ready(function () {
            let jobs_table = $("#table_report_jobs").kohaTable(
                {
                    ajax: { url: api_url() },
                    order: [[4, "desc"]],
                    rowCallback: function (row, data) {
                        if (data.status) {
                            $(row).addClass("job-status-" + data.status);
                        }
                        if (new_job_id && data.job_id == new_job_id) {
                            $(row).addClass("highlight");
                        }
                    },
                    columns: [
                        {
                            data: "job_id",
                            searchable: true,
                            orderable: true,
                        },
                        {
                            data: "report_name",
                            searchable: false,
                            orderable: false,
                            render: function (data, type, row) {
                                if (!row.report_id) return _("(report deleted)").escapeHtml();
                                const name = (row.report_name || _("Report #%s").format(row.report_id)).escapeHtml();
                                return '<a href="/cgi-bin/koha/reports/guided_reports.pl?op=show&id=' + encodeURIComponent(row.report_id) + '">' + name + "</a>";
                            },
                        },
                        {
                            data: "status",
                            searchable: true,
                            orderable: true,
                            render: function (data) {
                                return (job_status_labels[data] || data || "").escapeHtml();
                            },
                        },
                        {
                            data: "patron_name",
                            searchable: false,
                            orderable: false,
                            render: function (data, type, row) {
                                if (!row.patron_id) return "";
                                const name = (row.patron_name || _("Patron #%s").format(row.patron_id)).escapeHtml();
                                return '<a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=' + encodeURIComponent(row.patron_id) + '">' + name + "</a>";
                            },
                        },
                        {
                            data: "enqueued_date",
                            searchable: true,
                            orderable: true,
                            render: function (data) {
                                return data ? $datetime(data) : "";
                            },
                        },
                        {
                            data: "started_date",
                            searchable: true,
                            orderable: true,
                            render: function (data) {
                                return data ? $datetime(data) : "";
                            },
                        },
                        {
                            data: "ended_date",
                            searchable: true,
                            orderable: true,
                            render: function (data) {
                                return data ? $datetime(data) : "";
                            },
                        },
                        {
                            data: function (row) {
                                let actions = [];
                                const is_mine = row.patron_id == loggedinusernumber;

                                if (row.status === "finished" && row.saved_report_id) {
                                    actions.push(
                                        '<a class="btn btn-default btn-xs" href="/cgi-bin/koha/reports/guided_reports.pl?op=view_stored_results&id=' +
                                            encodeURIComponent(row.saved_report_id) +
                                            '"><i class="fa fa-eye" aria-hidden="true"></i> ' +
                                            _("View results") +
                                            "</a>"
                                    );
                                } else if (row.status === "failed" && row.error_message) {
                                    actions.push(
                                        '<button type="button" class="btn btn-outline-danger btn-xs view-error" ' +
                                            'data-error="' +
                                            row.error_message.escapeHtml() +
                                            '" ' +
                                            'data-error-code="' +
                                            (row.error_code || "").escapeHtml() +
                                            '">' +
                                            '<i class="fa fa-triangle-exclamation" aria-hidden="true"></i> ' +
                                            _("View error") +
                                            "</button>"
                                    );
                                }

                                if (row.status === "new" && (is_mine || can_see_all)) {
                                    actions.push('<button class="btn btn-default btn-xs cancel-job" data-job-id="' + encodeURIComponent(row.job_id) + '"><i class="fa fa-trash-can" aria-hidden="true"></i> ' + _("Cancel") + "</button>");
                                }

                                return actions.join(" ");
                            },
                            searchable: false,
                            orderable: false,
                        },
                    ],
                },
                null,
                1
            );

            $("#time_range").on("change", function () {
                $(".custom_range").toggle($(this).val() === "custom");
                if ($(this).val() !== "custom") {
                    jobs_table.DataTable().ajax.url(api_url()).load();
                }
            });

            $("#apply_custom").on("click", function () {
                jobs_table.DataTable().ajax.url(api_url()).load();
            });

            $("#table_report_jobs").on("click", ".cancel-job", function () {
                const job_id = $(this).data("job-id");
                if (!confirm(_("Cancel this queued report?"))) return;

                $.ajax({
                    url: "/api/v1/reports/jobs/" + encodeURIComponent(job_id) + "/cancel",
                    method: "POST",
                })
                    .done(function () {
                        jobs_table.DataTable().ajax.reload(null, false);
                    })
                    .fail(function (xhr) {
                        alert(_("Could not cancel the job: %s").format((xhr.responseJSON && xhr.responseJSON.error) || xhr.statusText));
                    });
            });

            const errorModal = new bootstrap.Modal(document.getElementById("errorModal"));
            $("#table_report_jobs").on("click", ".view-error", function () {
                const code = $(this).data("error-code");
                $("#errorModalCode").text(code ? error_code_labels[code] || code : "");
                $("#errorModalMessage").text($(this).data("error"));
                errorModal.show();
            });

            function format_seconds(s) {
                if (s == null) return "";
                if (s < 60) return _("%s sec").format(s);
                if (s < 3600) return _("%sm %ss").format(Math.floor(s / 60), s % 60);
                return _("%sh %sm").format(Math.floor(s / 3600), Math.floor((s % 3600) / 60));
            }

            let running_table = $("#table_running_reports").kohaTable(
                {
                    paging: false,
                    searching: false,
                    info: false,
                    columns: [
                        {
                            data: "report_name",
                            render: function (data, type, row) {
                                if (!row.report_id) return _("(report deleted)").escapeHtml();
                                const name = (row.report_name || _("Report #%s").format(row.report_id)).escapeHtml();
                                return '<a href="/cgi-bin/koha/reports/guided_reports.pl?op=show&id=' + encodeURIComponent(row.report_id) + '">' + name + "</a>";
                            },
                        },
                        {
                            data: "run_type",
                            render: function (data) {
                                return data === "background" ? _("Background").escapeHtml() : _("Foreground").escapeHtml();
                            },
                        },
                        {
                            data: "patron_name",
                            render: function (data, type, row) {
                                if (!row.patron_id) return "";
                                const name = (row.patron_name || _("Patron #%s").format(row.patron_id)).escapeHtml();
                                return '<a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=' + encodeURIComponent(row.patron_id) + '">' + name + "</a>";
                            },
                        },
                        {
                            data: "seconds",
                            render: function (data) {
                                return format_seconds(data).escapeHtml();
                            },
                        },
                    ],
                },
                null,
                1
            );

            function reload_running() {
                $.get("/api/v1/reports/jobs/running", function (rows) {
                    running_table.DataTable().clear().rows.add(rows).draw();
                    $("#table_running_reports").toggle(rows.length > 0);
                    $("#running_empty").toggle(rows.length === 0);
                });
            }

            function reload_all() {
                reload_running();
                jobs_table.DataTable().ajax.reload(null, false);
            }

            reload_running();

            let refresh_timer = null;
            let countdown_timer = null;
            function clear_timers() {
                if (refresh_timer) {
                    clearInterval(refresh_timer);
                    refresh_timer = null;
                }
                if (countdown_timer) {
                    clearInterval(countdown_timer);
                    countdown_timer = null;
                }
                $("#refresh_info").text("");
            }
            function start_refresh() {
                clear_timers();
                if (!$("#auto_refresh").is(":checked")) return;
                const delay_seconds = parseInt($("#refresh_delay").val(), 10);
                if (!delay_seconds || delay_seconds < 1) return;

                let next_refresh = new Date().getTime() + delay_seconds * 1000;
                refresh_timer = setInterval(function () {
                    reload_all();
                    next_refresh = new Date().getTime() + delay_seconds * 1000;
                }, delay_seconds * 1000);
                countdown_timer = setInterval(function () {
                    const remaining = Math.max(0, Math.round((next_refresh - new Date().getTime()) / 1000));
                    $("#refresh_info").text(_("Refresh in %s seconds").format(remaining));
                }, 1000);
            }
            $("#auto_refresh, #refresh_delay").on("change", start_refresh);
            $("#refresh_now").on("click", function () {
                reload_all();
                start_refresh();
            });
            start_refresh();
        });
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
