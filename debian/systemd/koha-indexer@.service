[Unit]
Description=Koha Zebra indexer daemon for %i
Documentation=man:koha-indexer(8)
PartOf=koha@%i.target
Requires=koha-create-dirs@%i.service
Before=koha@%i.target
After=koha-zebra@%i.service koha-create-dirs@%i.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%i-koha
Group=%i-koha
SyslogIdentifier=%i-koha-indexer
# Capture stdout/stderr to the same files the daemon(1) wrapper used under
# SysV, so log locations are identical whichever init package is installed.
StandardOutput=append:/var/log/koha/%i/indexer-output.log
StandardError=append:/var/log/koha/%i/indexer-error.log
WorkingDirectory=/var/lib/koha/%i
Environment=KOHA_CONF=/etc/koha/sites/%i/koha-conf.xml
Environment=KOHA_HOME=/usr/share/koha
Environment=PERL5LIB=/usr/share/koha/lib
ExecStartPre=+/usr/sbin/koha-generate-env indexer %i
EnvironmentFile=-/run/koha/%i/indexer.env
# INDEXER_DAEMON honours ALTERNATE_INDEXER_DAEMON and INDEXER_PARAMS from
# /etc/default/koha-common, resolved by koha-generate-env like koha-indexer
# does. $INDEXER_PARAMS is unbraced on purpose so it is split into arguments.
ExecStart=/usr/bin/env ${INDEXER_DAEMON} $INDEXER_PARAMS
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=koha@%i.target
