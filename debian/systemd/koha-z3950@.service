[Unit]
Description=Koha Z39.50/SRU server for %i
Documentation=man:koha-z3950-responder(8)
PartOf=koha@%i.target
Requires=koha-create-dirs@%i.service
Before=koha@%i.target
After=koha-create-dirs@%i.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=forking
User=%i-koha
Group=%i-koha
SyslogIdentifier=%i-koha-z3950
WorkingDirectory=/var/lib/koha/%i
Environment=KOHA_CONF=/etc/koha/sites/%i/koha-conf.xml
Environment=KOHA_HOME=/usr/share/koha
Environment=PERL5LIB=/usr/share/koha/lib
PIDFile=/run/koha/%i/z3950-responder.pid
ExecStartPre=+/usr/sbin/koha-generate-env z3950 %i
EnvironmentFile=-/run/koha/%i/z3950.env
# $Z3950_ADDITIONAL_OPTS is deliberately unbraced: systemd splits "$VAR" into
# separate arguments (and into none when empty) whereas "${VAR}" is always
# exactly one argument.
ExecStart=/usr/bin/perl /usr/share/koha/bin/z3950_responder.pl \
    $Z3950_ADDITIONAL_OPTS \
    --config-dir ${Z3950_CONFIGDIR} \
    -u %i-koha \
    -p /run/koha/%i/z3950-responder.pid \
    -D \
    -d %i-koha-z3950 \
    -l /var/log/koha/%i/z3950.log
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=koha@%i.target
