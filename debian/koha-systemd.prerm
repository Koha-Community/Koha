#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # Stop everything while the unit files are still present. Otherwise
        # the daemons keep running with no unit left to manage them, and a
        # swap to koha-sysv would start a second copy of each.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop koha-common.service koha.target >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
