#!/bin/sh

set -e

case "$1" in
    configure)
        # Bug 18250: Correct startup order of koha-common and memcached.
        # On non-systemd systems only: force the rc.d ordering.
        # On systemd, dh_installsystemd (via #DEBHELPER# below) enables and
        # starts koha-sysv.service automatically; no manual enable needed.
        if [ ! -d /run/systemd/system ]; then
            update-rc.d koha-common disable
            update-rc.d koha-common enable
        fi
        ;;
esac

#DEBHELPER#

exit 0
