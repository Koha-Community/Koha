use Modern::Perl;

use Test::NoWarnings;
use Test::More tests => 5;

use Koha::Database;
use Koha::ERM::EUsage::CounterFile;

use JSON           qw( decode_json );
use File::Basename qw( dirname );
use File::Slurp;

use t::lib::Mocks;
use t::lib::TestBuilder;
use Test::MockModule;

my $schema  = Koha::Database->new->schema;
my $builder = t::lib::TestBuilder->new;

my $patron = $builder->build_object( { class => 'Koha::Patrons' } );

my $sushi_response_file_TR_J1       = dirname(__FILE__) . "/../../../../data/erm/eusage/COUNTER_5.1/TR_J1.json";
my $sushi_counter_51_response_TR_J1 = read_file($sushi_response_file_TR_J1);
my $sushi_counter_report_TR_J1 =
    Koha::ERM::EUsage::SushiCounter->new( { response => decode_json($sushi_counter_51_response_TR_J1) } );

subtest 'store' => sub {

    plan tests => 4;

    $schema->storage->txn_begin;

    my $patron = Koha::Patrons->search()->last;
    t::lib::Mocks::mock_userenv( { number => $patron->borrowernumber } );    # Is superlibrarian

    my $usage_data_provider = $builder->build_object(
        { class => 'Koha::ERM::EUsage::UsageDataProviders', value => { name => 'TestProvider' } } );
    $usage_data_provider->{report_type} = 'TR_J1';

    my $now_time = POSIX::strftime( "%Y%m%d%H%M%S", localtime );

    my $counter_file = Koha::ERM::EUsage::CounterFile->new(
        {
            usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id,
            file_content           => $sushi_counter_report_TR_J1->get_COUNTER_from_SUSHI,
            date_uploaded          => $now_time,
            filename               => $usage_data_provider->name . "_" . $usage_data_provider->{report_type},
        }
    )->store;

    # UsageTitles are added on CounterFile->store
    my $titles_rs = Koha::ERM::EUsage::UsageTitles->search(
        { usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id } );

    # MonthlyUsages are added on CounterFile->store
    my $mus_rs = Koha::ERM::EUsage::MonthlyUsages->search(
        { usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id } );

    # YearlyUsages are rebuilt from the monthly usages
    my $yus_rs = Koha::ERM::EUsage::YearlyUsages->search(
        { usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id } );

    is( $titles_rs->count, 2,  '2 titles were added' );
    is( $mus_rs->count,    10, '10 monthly usages were added' );
    is( $yus_rs->count,    4,  '4 yearly usages are written' );

    my $yearly_usage   = $yus_rs->next;
    my $expected_total = 0;
    $expected_total += $_->usage_count
        for Koha::ERM::EUsage::MonthlyUsages->search(
        {
            title_id               => $yearly_usage->title_id,
            usage_data_provider_id => $yearly_usage->usage_data_provider_id,
            year                   => $yearly_usage->year,
            metric_type            => $yearly_usage->metric_type,
            report_type            => $yearly_usage->report_type,
        }
        )->as_list;
    is( $yearly_usage->totalcount, $expected_total, 'Yearly totalcount is the sum of the monthly usage counts' );

    $schema->storage->txn_rollback;

    #TODO: Test yop
    #TODO: acccess_type

};

subtest 'store month column separator' => sub {

    plan tests => 3;

    $schema->storage->txn_begin;

    my $patron = Koha::Patrons->search()->last;
    t::lib::Mocks::mock_userenv( { number => $patron->borrowernumber } );

    my $counter_file_content = $sushi_counter_report_TR_J1->get_COUNTER_from_SUSHI;
    like( $counter_file_content, qr/\b[A-Z][a-z]{2}-[0-9]{4}\b/, 'month columns use the Mmm-yyyy format' );

    # Files generated by older releases separated the month and year with a space
    my $space_separated_file_content = $counter_file_content;
    $space_separated_file_content =~ s/\b([A-Z][a-z]{2})-([0-9]{4})\b/$1 $2/g;

    foreach my $test (
        { label => 'Mmm-yyyy', file_content => $counter_file_content },
        { label => 'Mmm yyyy', file_content => $space_separated_file_content },
        )
    {
        my $usage_data_provider = $builder->build_object(
            { class => 'Koha::ERM::EUsage::UsageDataProviders', value => { name => 'TestProvider' } } );

        Koha::ERM::EUsage::CounterFile->new(
            {
                usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id,
                file_content           => $test->{file_content},
                date_uploaded          => POSIX::strftime( "%Y%m%d%H%M%S", localtime ),
                filename               => $usage_data_provider->name . "_TR_J1",
            }
        )->store;

        my $mus_rs = Koha::ERM::EUsage::MonthlyUsages->search(
            { usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id } );
        is( $mus_rs->count, 10, "10 monthly usages were added with $test->{label} columns" );
    }

    $schema->storage->txn_rollback;
};

subtest 'only the Regular access method is imported' => sub {

    plan tests => 8;

    $schema->storage->txn_begin;

    my $patron = Koha::Patrons->search()->last;
    t::lib::Mocks::mock_userenv( { number => $patron->borrowernumber } );    # Is superlibrarian

    my $usage_data_provider = $builder->build_object( { class => 'Koha::ERM::EUsage::UsageDataProviders' } );
    my $provider_id         = $usage_data_provider->erm_usage_data_provider_id;

    # A COUNTER file of release 5.1, Title Master Report, with an Access_Method column.
    # Each row is [ title, Access_Method, usage ] for the month
    my $counter_file_content = sub {
        my ( $month, @rows ) = @_;

        my @header = (
            'Report_Name,"Title Master Report"',
            'Report_ID,TR',
            'Release,5.1',
            'Institution_Name,"Test Institution"',
            'Institution_ID,',
            'Metric_Types,"Total_Item_Requests"',
            'Report_Filters,',
            'Report_Attributes,"Attributes_To_Show=Access_Method"',
            'Exceptions,""',
            'Reporting_Period,""',
            'Created,2026-10-30T02:13:31Z',
            'Created_By,"Test Systems Inc."',
            'Registry_Record,"https://registry.example.org"',
            '',
        );
        my $columns = qq{Title,Publisher,Access_Method,Metric_Type,Reporting_Period_Total,"$month"};
        my @lines   = map { qq{"$_->[0]",Publisher,"$_->[1]",Total_Item_Requests,$_->[2],$_->[2]} } @rows;

        return join( "\r\n", @header, $columns, @lines, '' );
    };

    my @messages;
    my $callbacks = {
        report_info_callback => sub { },
        step_callback        => sub { },
        set_size_callback    => sub { },
        add_message_callback => sub { push @messages, @_ },
    };
    my $skipped_messages = sub {
        [ grep { ( $_->{code} // q{} ) eq q{access_method_skipped} } @messages ]
    };

    my $store_file = sub {
        my ( $month, @rows ) = @_;

        return Koha::ERM::EUsage::CounterFile->new(
            {
                usage_data_provider_id => $provider_id,
                file_content           => $counter_file_content->( $month, @rows ),
                date_uploaded          => POSIX::strftime( "%Y%m%d%H%M%S", localtime ),
                filename               => 'upload',
            }
        )->store($callbacks);
    };

    # A title with Regular and TDM usage, a title with TDM usage only, a title without an access method
    # and a title with the Regular access method in lower case
    $store_file->(
        'Oct-2026',
        [ 'Title A', 'Regular', 5 ],
        [ 'Title A', 'TDM',     50 ],
        [ 'Title B', 'TDM',     30 ],
        [ 'Title C', q{},       7 ],
        [ 'Title D', 'regular', 3 ],
    );

    is(
        Koha::ERM::EUsage::UsageTitles->search( { usage_data_provider_id => $provider_id } )->count,
        3, 'A title with TDM usage only is not added'
    );
    is(
        Koha::ERM::EUsage::UsageTitles->search( { usage_data_provider_id => $provider_id, title => 'Title B' } )->count,
        0, 'Title B is not added'
    );
    is_deeply(
        [
            sort { $a <=> $b }
            map  { $_->usage_count }
                Koha::ERM::EUsage::MonthlyUsages->search( { usage_data_provider_id => $provider_id } )->as_list
        ],
        [ 3, 5, 7 ],
        'Only the usage of the Regular access method, of no access method and of regular is stored'
    );

    my $title_a =
        Koha::ERM::EUsage::UsageTitles->search( { usage_data_provider_id => $provider_id, title => 'Title A' } )->next;
    is(
        Koha::ERM::EUsage::YearlyUsages->search( { title_id => $title_a->title_id } )->next->totalcount, 5,
        'The TDM usage is not in the yearly usage'
    );

    is_deeply(
        [ map { $_->{type} . q{ } . $_->{message} } @{ $skipped_messages->() } ],
        ['warning 2'],
        'One warning gives the number of rows that were not imported'
    );

    # A file with TDM usage only
    @messages = ();
    $store_file->( 'Nov-2026', [ 'Title E', 'TDM', 40 ], [ 'Title F', 'TDM', 60 ] );
    is(
        Koha::ERM::EUsage::MonthlyUsages->search( { usage_data_provider_id => $provider_id, month => 11 } )->count, 0,
        'A file with TDM usage only adds no usage'
    );
    is_deeply(
        [ map { $_->{message} } @{ $skipped_messages->() } ],
        [2], 'The warning gives the two rows that were not imported'
    );
    is(
        Koha::ERM::EUsage::UsageTitles->search( { usage_data_provider_id => $provider_id } )->count,
        3, 'No title is added by a file with TDM usage only'
    );

    $schema->storage->txn_rollback;
};

subtest '_get_rows_from_COUNTER_file' => sub {

    plan tests => 4;

    $schema->storage->txn_begin;

    my $usage_data_provider = $builder->build_object(
        { class => 'Koha::ERM::EUsage::UsageDataProviders', value => { name => 'TestProvider' } } );
    $usage_data_provider->{report_type} = 'TR_J1';

    my $now_time = POSIX::strftime( "%Y%m%d%H%M%S", localtime );

    my $counter_file = $builder->build_object(
        {
            class => 'Koha::ERM::EUsage::CounterFiles',
            value => {
                usage_data_provider_id => $usage_data_provider->erm_usage_data_provider_id,
                file_content           => $sushi_counter_report_TR_J1->get_COUNTER_from_SUSHI,
                date_uploaded          => $now_time,
                filename               => $usage_data_provider->name . "_" . $usage_data_provider->{report_type},
            }
        }
    );

    my $counter_file_rows = $counter_file->_get_rows_from_COUNTER_file;

    is( ref $counter_file_rows, 'ARRAY', '_get_rows_from_COUNTER_file returns array' );
    is(
        scalar @{$counter_file_rows}, 4,
        '_get_rows_from_COUNTER_file returns correct number of rows'
    );
    is(
        @{$counter_file_rows}[0]->{Title}, 'Education and Training',
        'first and second report row is about the same title'
    );
    is(
        @{$counter_file_rows}[1]->{Title}, 'Education and Training',
        'first and second report row is about the same title'
    );

    $schema->storage->txn_rollback;

};
