<!DOCTYPE html>
<!-- prettier-ignore-start -->
[% USE raw %]
<html>
    <head>
        <title>[% plugin_name | html %] - Valuebuilder</title>
        <meta charset="UTF-8" />
    </head>
    <body id="test_valuebuilder_popup" class="test_valuebuilder_popup">
        <h1>[% plugin_name | html %]</h1>
        <p>This is a test valuebuilder popup for field: [% field_id | html %]</p>

        <form>
            <label for="test_value">Enter a value:</label>
            <input type="text" id="test_value" value="Test Value from Plugin" />
            <br /><br />
            <button type="button" onclick="setValueAndClose()">Set Value</button>
            <button type="button" onclick="window.close()">Cancel</button>
        </form>
        <script nonce="[% Koha.CSPNonce | $raw %]"  data-tt-allowed="true">
            var field_id = "[% field_id | html %]";
        </script>
        <script nonce="[% Koha.CSPNonce | $raw %]">
            function setValueAndClose() {
                var value = document.getElementById('test_value').value;
                if (window.opener && window.opener.document.getElementById(field_id)) {
                    window.opener.document.getElementById(field_id).value = value;
                }
                window.close();
            }
        </script>
    </body>
</html>
<!-- prettier-ignore-end -->
